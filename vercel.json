{
  "version": 2,
  "trailingSlash": true,
  "routes": [
    {
      "src": "/status.json",
      "dest": "/status.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/demo",
      "status": 308,
      "headers": {
        "Location": "/demo/"
      }
    },
    {
      "src": "/demo/(.*)",
      "dest": "/demo/$1"
    },
    {
      "src": "/yc-demo",
      "status": 308,
      "headers": {
        "Location": "/demo/"
      }
    },
    {
      "src": "/yc-demo/(.*)",
      "status": 308,
      "headers": {
        "Location": "/demo/"
      }
    },
    {
      "src": "/atlas",
      "status": 308,
      "headers": {
        "Location": "/atlas/"
      }
    },
    {
      "src": "/atlas/(.*)",
      "dest": "/atlas/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
