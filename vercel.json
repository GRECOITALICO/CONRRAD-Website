{
  "version": 2,
  "routes": [
    {
      "src": "/status.json",
      "dest": "/status.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/demo",
      "status": 308,
      "headers": {
        "Location": "/demo/"
      }
    },
    {
      "src": "/demo/(.*)",
      "dest": "/demo/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
